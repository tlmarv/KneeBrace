<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KneeBrace-Eval — Sports Knee Brace Donning & Fit Accuracy Platform</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            clinical: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              500: '#0284c7',
              600: '#0369a1',
              700: '#075985',
              800: '#0c4a6e',
              900: '#082f49',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Orthopedic/Clinical viewport canvas grid */
    .viewport-grid {
      background-size: 24px 24px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    }
    /* Radio Pill Button Active Styling */
    .score-radio:checked + label {
      border-color: #0284c7;
      background-color: #0369a1;
      color: #ffffff;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.15);
    }
    .score-radio-zero:checked + label {
      border-color: #e11d48;
      background-color: #be123c;
      color: #ffffff;
    }
    .score-radio-indet:checked + label {
      border-color: #d97706;
      background-color: #b45309;
      color: #ffffff;
    }
    /* Scrollbars */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased h-screen flex flex-col overflow-hidden selection:bg-clinical-100 selection:text-clinical-900">

  <!-- ================= TOP NAVIGATION BAR ================= -->
  <header class="bg-white border-b border-slate-200 px-4 py-2.5 flex items-center justify-between shrink-0 z-20 shadow-xs">
    <div class="flex items-center space-x-3">
      <div class="h-8 w-8 rounded-lg bg-clinical-700 text-white flex items-center justify-center font-bold shadow-xs">
        <i data-lucide="crosshair" class="w-5 h-5"></i>
      </div>
      <div>
        <h1 class="text-sm font-bold text-slate-900 leading-tight">KneeBrace-Eval Protocol</h1>
        <p class="text-[11px] text-slate-500 font-medium">Sports Knee Brace Donning & Fit Accuracy Assessment</p>
      </div>
    </div>

    <!-- Central Progress & Blinding Bar -->
    <div class="hidden md:flex items-center space-x-4">
      <div class="flex items-center gap-2 bg-slate-100 px-3 py-1 rounded-md border border-slate-200 text-xs">
        <span class="text-slate-500 font-medium">Image:</span>
        <span id="currentImageIndexBadge" class="font-bold font-mono text-slate-800">1 / 1</span>
        <div class="w-20 bg-slate-200 rounded-full h-1.5 overflow-hidden ml-1">
          <div id="studyProgressBar" class="bg-clinical-600 h-1.5 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>
      
      <label class="flex items-center gap-1.5 text-xs text-slate-600 cursor-pointer select-none">
        <input type="checkbox" id="blindingToggle" onchange="toggleBlindingMode()" class="rounded border-slate-300 text-clinical-600 focus:ring-clinical-500 w-3.5 h-3.5">
        <span class="font-medium">Double-Blinded</span>
      </label>
    </div>

    <!-- Evaluator & Action Controls -->
    <div class="flex items-center space-x-2">
      <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-2.5 py-1 rounded-md text-xs">
        <i data-lucide="user" class="w-3.5 h-3.5 text-slate-500"></i>
        <span class="text-slate-400 text-[10px] uppercase font-bold">Rater:</span>
        <span id="displayRaterId" class="font-mono font-bold text-slate-800">RATER_01</span>
      </div>

      <button onclick="openConfigModal()" title="Dataset & Cloud Settings" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-md border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition shadow-2xs">
        <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5"></i>
        <span class="hidden sm:inline">Settings</span>
      </button>

      <button onclick="openAppsScriptModal()" title="Google Sheets Integration Script" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-md border border-emerald-300 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 transition">
        <i data-lucide="table" class="w-3.5 h-3.5"></i>
        <span class="hidden sm:inline">Backend Script</span>
      </button>

      <button onclick="exportCSV()" title="Download aggregated CSV dataset" class="inline-flex items-center gap-1 px-3 py-1 text-xs font-bold rounded-md bg-clinical-700 hover:bg-clinical-800 text-white transition shadow-2xs">
        <i data-lucide="download" class="w-3.5 h-3.5"></i>
        <span>Export CSV</span>
      </button>
    </div>
  </header>

  <!-- Notification Toast Container -->
  <div id="toastContainer" class="fixed top-14 right-4 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

  <!-- ================= MAIN WORKSPACE (SPLIT-SCREEN) ================= -->
  <main class="flex-1 grid grid-cols-1 lg:grid-cols-12 overflow-hidden gap-0">
    
    <!-- LEFT PANEL: IMAGE INSPECTION WORKSPACE (7 Cols) -->
    <section class="lg:col-span-7 flex flex-col bg-slate-900 border-r border-slate-300 relative h-full overflow-hidden select-none">
      
      <!-- Viewport Header Toolbar -->
      <div class="px-4 py-2 bg-slate-900/90 backdrop-blur-xs border-b border-slate-800 flex items-center justify-between z-10 text-xs text-slate-300">
        <div class="flex items-center space-x-2">
          <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Specimen:</span>
          <span id="activeImageFilename" class="font-mono bg-slate-800 px-2 py-0.5 rounded text-white font-semibold">BRACE_001.jpg</span>
          <span id="flagIndicatorBadge" class="hidden text-[10px] bg-rose-900/70 border border-rose-500 text-rose-200 px-1.5 py-0.5 rounded font-medium items-center gap-1">
            <i data-lucide="flag" class="w-3 h-3 text-rose-400"></i> Consensus Review
          </span>
        </div>

        <div class="flex items-center gap-3 text-[11px] text-slate-400">
          <span class="hidden sm:inline">Pan: <b>Drag</b> | Zoom: <b>Scroll</b></span>
          <span class="hidden md:inline font-mono text-slate-500">Hotkeys: [R] Reset | [Enter] Next</span>
        </div>
      </div>

      <!-- Canvas / Viewport Container -->
      <div id="imageViewport" class="flex-1 relative overflow-hidden viewport-grid flex items-center justify-center cursor-grab active:cursor-grabbing">
        
        <!-- Empty placeholder alert -->
        <div id="emptyNotice" class="hidden text-center text-slate-400 p-6 z-10">
          <i data-lucide="image-off" class="w-12 h-12 mx-auto mb-2 text-slate-500"></i>
          <p class="text-sm font-semibold">No images remaining in current batch</p>
          <button onclick="openConfigModal()" class="mt-2 text-xs text-clinical-400 underline font-medium">Load image dataset in settings</button>
        </div>

        <!-- Transformable Wrapper -->
        <div id="imageTransformContainer" class="transform origin-center transition-transform duration-75 ease-out inline-block">
          <img id="mainImage" src="" alt="Brace specimen" class="max-w-none max-h-[75vh] rounded shadow-2xl pointer-events-none block object-contain">
        </div>

        <!-- Floating Magnification HUD -->
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 bg-slate-900/80 backdrop-blur-md text-white rounded-full px-3 py-1 flex items-center gap-2 border border-slate-700 shadow-xl text-xs z-10">
          <button onclick="adjustZoom(-0.25)" title="Zoom Out (-)" class="p-1 hover:bg-slate-800 rounded-full transition">
            <i data-lucide="minus" class="w-3.5 h-3.5"></i>
          </button>
          <span id="zoomDisplay" class="font-mono text-[11px] w-12 text-center font-bold">100%</span>
          <button onclick="adjustZoom(0.25)" title="Zoom In (+)" class="p-1 hover:bg-slate-800 rounded-full transition">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          </button>
          <div class="h-3 w-px bg-slate-700 mx-0.5"></div>
          <button onclick="resetZoomPan()" title="Reset Zoom (R)" class="p-1 hover:bg-slate-800 rounded-full transition text-slate-300 hover:text-white">
            <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
          </button>
          <button onclick="toggleInvertColors()" title="Contrast / Inversion Filter" class="p-1 hover:bg-slate-800 rounded-full transition text-slate-300 hover:text-white">
            <i data-lucide="sun-medium" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>

      <!-- Viewport Bottom Navigation Strip -->
      <div class="px-4 py-2.5 bg-slate-900 border-t border-slate-800 flex items-center justify-between text-xs text-white z-10">
        <div class="flex items-center gap-2">
          <button id="prevBtn" onclick="navigateImage(-1)" class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 disabled:opacity-30 disabled:cursor-not-allowed border border-slate-700 font-medium transition">
            <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i> Previous
          </button>
          <button id="nextBtn" onclick="navigateImage(1)" class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 disabled:opacity-30 disabled:cursor-not-allowed border border-slate-700 font-medium transition">
            Skip / Next <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
          </button>
        </div>

        <button id="btnToggleFlag" onclick="toggleConsensusFlag()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium transition">
          <i data-lucide="flag" class="w-3.5 h-3.5" id="flagBtnIcon"></i>
          <span id="flagBtnText">Flag for Consensus</span>
        </button>
      </div>
    </section>

    <!-- RIGHT PANEL: ORTHOPEDIC RUBRIC SCORING SUITE (5 Cols) -->
    <section class="lg:col-span-5 bg-white flex flex-col h-full overflow-hidden shadow-lg border-l border-slate-200">
      
      <!-- Rubric Summary Header & Live Computed Score -->
      <div class="px-5 py-3 border-b border-slate-200 bg-slate-50 flex items-center justify-between shrink-0">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-600">Donning Accuracy Rubric</h2>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="text-[11px] text-slate-500">Fit Threshold: 6/6 Mandatory</span>
            <span id="cloudSyncStatus" class="text-[10px] font-mono text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200 inline-flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Synced
            </span>
          </div>
        </div>

        <div class="text-right">
          <div class="flex items-baseline justify-end gap-1">
            <span id="totalScoreNum" class="text-2xl font-black text-slate-900 font-mono">0</span>
            <span class="text-xs text-slate-500 font-bold">/ 6</span>
          </div>
          <span id="passFailBadge" class="text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wide bg-slate-200 text-slate-600">INCOMPLETE</span>
        </div>
      </div>

      <!-- Scrollable Form Container -->
      <form id="rubricForm" onsubmit="event.preventDefault();" class="flex-1 overflow-y-auto p-4 space-y-4 text-xs">

        <!-- ================= CATEGORY 1 ================= -->
        <div class="p-3 bg-white border border-slate-200 rounded-lg shadow-2xs hover:border-slate-300 transition">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[10px] font-bold text-clinical-700 uppercase tracking-wider">Category 1</span>
              <h3 class="font-bold text-slate-900 text-xs">Vertical / Axial Orientation</h3>
            </div>
            <button type="button" onclick="toggleCriteriaHelp('helpCat1')" class="text-slate-400 hover:text-clinical-600">
              <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
            </button>
          </div>
          
          <div id="helpCat1" class="hidden my-2 p-2 bg-slate-50 rounded text-[11px] text-slate-600 border border-slate-200 space-y-1">
            <p><strong>1 (Correct):</strong> Wider thigh frame/cuffs are proximal; narrower calf distal; hinge ROM stops/pins per design.</p>
            <p><strong>0 (Inaccurate):</strong> Completely upside down (e.g. calf shell over thigh, condyle hinges over tibial shaft).</p>
            <p><strong>9 (Indeterminate):</strong> Extreme zoom showing only hinge center, obscuring upper & lower cuffs.</p>
          </div>

          <div class="grid grid-cols-3 gap-1.5 mt-2.5">
            <div>
              <input type="radio" name="cat1" id="cat1_1" value="1" class="hidden score-radio" onchange="onScoreChange()">
              <label for="cat1_1" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Correct (1)</span>
              </label>
            </div>
            <div>
              <input type="radio" name="cat1" id="cat1_0" value="0" class="hidden score-radio score-radio-zero" onchange="onScoreChange()">
              <label for="cat1_0" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Inaccurate (0)</span>
              </label>
            </div>
            <div>
              <input type="radio" name="cat1" id="cat1_9" value="9" class="hidden score-radio score-radio-indet" onchange="onScoreChange()">
              <label for="cat1_9" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Indeterminate (9)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- ================= CATEGORY 2 ================= -->
        <div class="p-3 bg-white border border-slate-200 rounded-lg shadow-2xs hover:border-slate-300 transition">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[10px] font-bold text-clinical-700 uppercase tracking-wider">Category 2</span>
              <h3 class="font-bold text-slate-900 text-xs">Joint Line / Epicondylar Center</h3>
            </div>
            <button type="button" onclick="toggleCriteriaHelp('helpCat2')" class="text-slate-400 hover:text-clinical-600">
              <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
            </button>
          </div>

          <div id="helpCat2" class="hidden my-2 p-2 bg-slate-50 rounded text-[11px] text-slate-600 border border-slate-200 space-y-1">
            <p><strong>1 (Correct):</strong> Hinge center falls within condylar zone: superior patella to tibial tubercle (≤ 1.5–2.0 cm of lateral epicondyle / joint line).</p>
            <p><strong>0 (Inaccurate):</strong> Gross vertical migration. Hinge proximal to superior patella (mid-femur) or distal to tibial tuberosity (tibia).</p>
            <p><strong>9 (Indeterminate):</strong> Hinge covered by clothing, extreme frontal view hiding axis, or leg cropped at knee joint.</p>
          </div>

          <div class="grid grid-cols-3 gap-1.5 mt-2.5">
            <div>
              <input type="radio" name="cat2" id="cat2_1" value="1" class="hidden score-radio" onchange="onScoreChange()">
              <label for="cat2_1" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Correct (1)</span>
              </label>
            </div>
            <div>
              <input type="radio" name="cat2" id="cat2_0" value="0" class="hidden score-radio score-radio-zero" onchange="onScoreChange()">
              <label for="cat2_0" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Inaccurate (0)</span>
              </label>
            </div>
            <div>
              <input type="radio" name="cat2" id="cat2_9" value="9" class="hidden score-radio score-radio-indet" onchange="onScoreChange()">
              <label for="cat2_9" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Indeterminate (9)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- ================= CATEGORY 3 ================= -->
        <div class="p-3 bg-white border border-slate-200 rounded-lg shadow-2xs hover:border-slate-300 transition">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[10px] font-bold text-clinical-700 uppercase tracking-wider">Category 3</span>
              <h3 class="font-bold text-slate-900 text-xs">Anteroposterior (AP) Plane Position</h3>
            </div>
            <button type="button" onclick="toggleCriteriaHelp('helpCat3')" class="text-slate-400 hover:text-clinical-600">
              <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
            </button>
          </div>

          <div id="helpCat3" class="hidden my-2 p-2 bg-slate-50 rounded text-[11px] text-slate-600 border border-slate-200 space-y-1">
            <p><strong>1 (Correct):</strong> Upright struts align with mid-lateral/mid-medial line of leg (angle deviation ≤ 15° from coronal mid-axis).</p>
            <p><strong>0 (Inaccurate):</strong> Severe rotational malalignment. Uprights visibly rotated anteriorly over quad/patella or into popliteal fossa (> 15°).</p>
            <p><strong>9 (Indeterminate):</strong> Pure AP (direct anterior) or posterior camera view where coronal depth cannot be resolved.</p>
          </div>

          <div class="grid grid-cols-3 gap-1.5 mt-2.5">
            <div>
              <input type="radio" name="cat3" id="cat3_1" value="1" class="hidden score-radio" onchange="onScoreChange()">
              <label for="cat3_1" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Correct (1)</span>
              </label>
            </div>
            <div>
              <input type="radio" name="cat3" id="cat3_0" value="0" class="hidden score-radio score-radio-zero" onchange="onScoreChange()">
              <label for="cat3_0" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Inaccurate (0)</span>
              </label>
            </div>
            <div>
              <input type="radio" name="cat3" id="cat3_9" value="9" class="hidden score-radio score-radio-indet" onchange="onScoreChange()">
              <label for="cat3_9" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Indeterminate (9)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- ================= CATEGORY 4 ================= -->
        <div class="p-3 bg-white border border-slate-200 rounded-lg shadow-2xs hover:border-slate-300 transition">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[10px] font-bold text-clinical-700 uppercase tracking-wider">Category 4</span>
              <h3 class="font-bold text-slate-900 text-xs">Patellar Alignment & Window</h3>
            </div>
            <button type="button" onclick="toggleCriteriaHelp('helpCat4')" class="text-slate-400 hover:text-clinical-600">
              <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
            </button>
          </div>

          <div id="helpCat4" class="hidden my-2 p-2 bg-slate-50 rounded text-[11px] text-slate-600 border border-slate-200 space-y-1">
            <p><strong>1 (Correct):</strong> Patella centered in cutout/buttress (≤ 1/3 overlap), or open-frame clearance arch crosses superior to patella without compression.</p>
            <p><strong>0 (Inaccurate):</strong> Cutout rests over quad tendon, over tibial tuberosity, or patella displaced under solid cuff/neoprene.</p>
            <p><strong>9 (Indeterminate):</strong> Pure lateral profile hiding patellar centering, or brace design lacks anterior reference window.</p>
          </div>

          <div class="grid grid-cols-3 gap-1.5 mt-2.5">
            <div>
              <input type="radio" name="cat4" id="cat4_1" value="1" class="hidden score-radio" onchange="onScoreChange()">
              <label for="cat4_1" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Correct (1)</span>
              </label>
            </div>
            <div>
              <input type="radio" name="cat4" id="cat4_0" value="0" class="hidden score-radio score-radio-zero" onchange="onScoreChange()">
              <label for="cat4_0" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Inaccurate (0)</span>
              </label>
            </div>
            <div>
              <input type="radio" name="cat4" id="cat4_9" value="9" class="hidden score-radio score-radio-indet" onchange="onScoreChange()">
              <label for="cat4_9" class="flex flex-col items-center justify-center p-2 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 cursor-pointer font-semibold text-xs transition">
                <span class="text-xs">Indeterminate (9)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- ================= CATEGORY 5 ================= -->
        <div class="p-3 bg-white border border-slate-200 rounded-lg shadow-2xs hover:border-slate-300 transition">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[10px] font-bold text-clinical-700 uppercase tracking-wider">Category 5</span>
              <h3 class="font-bold text-slate-900 text-xs">Skin Interface vs. Layering</h3>
            </div>
            <button type="button" onclick="toggleCriteriaHelp('helpCat5')" class="text-slate-400 hover:text-clinical-600">
              <i data-lucide="help-circle" class="w-3.5 h-3.5"></i>
            </button>
          </div>

          <div id="helpCat5" class="hidden my-2 p-2 bg-slate-50 rounded text-[11px] text-slate-600 border border-slate-200 space-y-1">
            <p><strong>1 (Correct):</strong> Bare skin, under athletic short, or over single thin compression tight / medical cotton undersleeve without bunching.</p>
            <p><strong>0 (Inaccurate):</strong> Donned over loose, thick, or wrinkled outerwear (jeans, cargo pants, bulky fleece sweatpants, multi-layers).</p>
            <p><strong>9 (Indeterminate):</strong> Frame-tight crop making it impossible to resolve fabric thickness from thin undersleeve.</p>
          </div>

          <div class="grid grid-cols-3 gap-1.5 mt-2.5">
            <div>
              <input type="radio" name="cat5" id="cat5_1" value="1" class="hidden score-radio" onchange="onScoreChange()">
