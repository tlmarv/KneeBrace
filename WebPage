  <!-- ================= JAVASCRIPT APPLICATION LOGIC ================= -->
  <script>
    /* ==========================================================================
       SAMPLE RESEARCH IMAGERY & STATE
       ========================================================================== */
    const DEFAULT_SPECIMENS = [
      {
        id: "BRACE_001.jpg",
        url: "https://images.unsplash.com/photo-1584820927498-cfe5211fd8bf?auto=format&fit=crop&w=1200&q=80"
      },
      {
        id: "BRACE_002.jpg",
        url: "https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&w=1200&q=80"
      },
      {
        id: "BRACE_003.jpg",
        url: "https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=1200&q=80"
      },
      {
        id: "BRACE_004.jpg",
        url: "https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=1200&q=80"
      }
    ];

    let studyState = {
      raterId: "RATER_01",
      webhookUrl: "",
      blinded: false,
      images: [...DEFAULT_SPECIMENS],
      currentIndex: 0,
      scores: {}, // Keyed by image id
      zoom: 1,
      pan: { x: 0, y: 0 },
      isDragging: false,
      dragStart: { x: 0, y: 0 },
      invertContrast: false
    };

    /* ==========================================================================
       INITIALIZATION
       ========================================================================== */
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      loadFromStorage();
      renderCurrentImage();
      setupViewportControls();
      setupHotkeys();
      populateAppsScriptTemplate();
    });

    /* ==========================================================================
       PAN & ZOOM INTERACTION ENGINE
       ========================================================================== */
    function setupViewportControls() {
      const viewport = document.getElementById('imageViewport');

      // Wheel Zoom
      viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        const delta = e.deltaY < 0 ? 0.2 : -0.2;
        adjustZoom(delta);
      }, { passive: false });

      // Mouse drag
      viewport.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        studyState.isDragging = true;
        studyState.dragStart = { x: e.clientX - studyState.pan.x, y: e.clientY - studyState.pan.y };
      });

      window.addEventListener('mousemove', (e) => {
        if (!studyState.isDragging) return;
        studyState.pan.x = e.clientX - studyState.dragStart.x;
        studyState.pan.y = e.clientY - studyState.dragStart.y;
        applyTransform();
      });

      window.addEventListener('mouseup', () => {
        studyState.isDragging = false;
      });

      // Touch Drag & Pinch Zoom
      let initialDist = 0;
      viewport.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          studyState.isDragging = true;
          studyState.dragStart = { x: e.touches[0].clientX - studyState.pan.x, y: e.touches[0].clientY - studyState.pan.y };
        } else if (e.touches.length === 2) {
          initialDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
        }
      });

      viewport.addEventListener('touchmove', (e) => {
        if (e.touches.length === 1 && studyState.isDragging) {
          studyState.pan.x = e.touches[0].clientX - studyState.dragStart.x;
          studyState.pan.y = e.touches[0].clientY - studyState.dragStart.y;
          applyTransform();
        } else if (e.touches.length === 2) {
          const currentDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          if (initialDist > 0) {
            const zoomDelta = (currentDist - initialDist) * 0.005;
            adjustZoom(zoomDelta);
            initialDist = currentDist;
          }
        }
      });

      viewport.addEventListener('touchend', () => {
        studyState.isDragging = false;
      });
    }

    function adjustZoom(delta) {
      let nextZoom = studyState.zoom + delta;
      if (nextZoom < 0.4) nextZoom = 0.4;
      if (nextZoom > 6.0) nextZoom = 6.0;
      studyState.zoom = Math.round(nextZoom * 100) / 100;
      applyTransform();
    }

    function resetZoomPan() {
      studyState.zoom = 1;
      studyState.pan = { x: 0, y: 0 };
      applyTransform();
    }

    function applyTransform() {
      const container = document.getElementById('imageTransformContainer');
      const img = document.getElementById('mainImage');
      container.style.transform = `translate(${studyState.pan.x}px, ${studyState.pan.y}px) scale(${studyState.zoom})`;
      document.getElementById('zoomDisplay').textContent = `${Math.round(studyState.zoom * 100)}%`;
      
      if (studyState.invertContrast) {
        img.style.filter = "invert(1) contrast(1.2)";
      } else {
        img.style.filter = "none";
      }
    }

    function toggleInvertColors() {
      studyState.invertContrast = !studyState.invertContrast;
      applyTransform();
      showToast(studyState.invertContrast ? "High Contrast Inversion Enabled" : "Normal Display Restored", "info");
    }

    /* ==========================================================================
       KEYBOARD HOTKEYS
       ========================================================================== */
    function setupHotkeys() {
      window.addEventListener('keydown', (e) => {
        // Prevent hotkeys from firing while typing in notes/inputs
        const tag = document.activeElement.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

        if (e.key === 'r' || e.key === 'R') {
          e.preventDefault();
          resetZoomPan();
        } else if (e.key === '+' || e.key === '=') {
          e.preventDefault();
          adjustZoom(0.25);
        } else if (e.key === '-' || e.key === '_') {
          e.preventDefault();
          adjustZoom(-0.25);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          saveAndAdvance();
        } else if (e.key === 'Backspace' || e.key === 'p' || e.key === 'P') {
          e.preventDefault();
          navigateImage(-1);
        }
      });
    }

    /* ==========================================================================
       IMAGE DISPLAY & FORM POPULATION
       ========================================================================== */
    function renderCurrentImage() {
      const images = studyState.images;
      const current = images[studyState.currentIndex];

      if (!current) {
        document.getElementById('mainImage').style.display = 'none';
        document.getElementById('emptyNotice').classList.remove('hidden');
        document.getElementById('activeImageFilename').textContent = "NONE";
        return;
      }

      document.getElementById('emptyNotice').classList.add('hidden');
      const img = document.getElementById('mainImage');
      img.style.display = 'block';
      img.src = current.url;

      // Handle Blinded Mode Masking
      const displayFilename = studyState.blinded ? `BLINDED_SPECIMEN_${studyState.currentIndex + 1}` : current.id;
      document.getElementById('activeImageFilename').textContent = displayFilename;
      document.getElementById('currentImageIndexBadge').textContent = `${studyState.currentIndex + 1} / ${images.length}`;

      // Update Top Progress Bar
      const pct = images.length > 0 ? ((studyState.currentIndex + 1) / images.length) * 100 : 0;
      document.getElementById('studyProgressBar').style.width = `${pct}%`;

      document.getElementById('prevBtn').disabled = studyState.currentIndex === 0;
      document.getElementById('nextBtn').disabled = studyState.currentIndex >= images.length - 1;

      resetZoomPan();
      populateFormFromSaved();
      onScoreChange();
    }

    function populateFormFromSaved() {
      const current = studyState.images[studyState.currentIndex];
      if (!current) return;

      const saved = studyState.scores[current.id];

      // Reset all radio selections
      for (let i = 1; i <= 6; i++) {
        const radios = document.querySelectorAll(`input[name="cat${i}"]`);
        radios.forEach(r => r.checked = false);
      }

      const flagIndicator = document.getElementById('flagIndicatorBadge');
      const flagBtnIcon = document.getElementById('flagBtnIcon');
      const flagBtnText = document.getElementById('flagBtnText');
      const flagNoteBox = document.getElementById('flagNoteContainer');

      if (saved) {
        for (let i = 1; i <= 6; i++) {
          const val = saved[`cat${i}`];
          if (val !== undefined && val !== null) {
            const rad = document.getElementById(`cat${i}_${val}`);
            if (rad) rad.checked = true;
          }
        }
        document.getElementById('postureSelect').value = saved.postureClass || "Seated_Flexed_30_90";
        document.getElementById('settingSelect').value = saved.settingClass || "Clinical_Rehab";
        document.getElementById('confidenceRange').value = saved.confidenceLevel || 5;
        updateConfidenceText(saved.confidenceLevel || 5);
        document.getElementById('raterNotes').value = saved.notes || "";
        document.getElementById('flagReasonInput').value = saved.flagReason || "";

        if (saved.flagConsensus) {
          flagIndicator.classList.remove('hidden');
          flagIndicator.classList.add('inline-flex');
          flagBtnIcon.setAttribute('class', 'w-3.5 h-3.5 text-rose-400');
          flagBtnText.textContent = "Flagged";
          flagNoteBox.classList.remove('hidden');
        } else {
          flagIndicator.classList.add('hidden');
          flagIndicator.classList.remove('inline-flex');
          flagBtnIcon.setAttribute('class', 'w-3.5 h-3.5 text-slate-400');
          flagBtnText.textContent = "Flag for Consensus";
          flagNoteBox.classList.add('hidden');
        }
      } else {
        document.getElementById('postureSelect').value = "Seated_Flexed_30_90";
        document.getElementById('settingSelect').value = "Clinical_Rehab";
        document.getElementById('confidenceRange').value = 5;
        updateConfidenceText(5);
        document.getElementById('raterNotes').value = "";
        document.getElementById('flagReasonInput').value = "";

        flagIndicator.classList.add('hidden');
        flagIndicator.classList.remove('inline-flex');
        flagBtnIcon.setAttribute('class', 'w-3.5 h-3.5 text-slate-400');
        flagBtnText.textContent = "Flag for Consensus";
        flagNoteBox.classList.add('hidden');
      }
      lucide.createIcons();
    }

    /* ==========================================================================
       SCORING LOGIC & COMPUTED METRICS
       ========================================================================== */
    function onScoreChange() {
      let sum = 0;
      let allAnswered = true;
      let hasZeroOrIndeterminate = false;

      for (let i = 1; i <= 6; i++) {
        const checked = document.querySelector(`input[name="cat${i}"]:checked`);
        if (checked) {
          const val = parseInt(checked.value, 10);
          if (val === 1) sum += 1;
          if (val === 0 || val === 9) hasZeroOrIndeterminate = true;
        } else {
          allAnswered = false;
        }
      }

      document.getElementById('totalScoreNum').textContent = sum;
      const badge = document.getElementById('passFailBadge');

      if (!allAnswered) {
        badge.textContent = "INCOMPLETE";
        badge.className = "text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wide bg-slate-200 text-slate-600";
      } else if (sum === 6) {
        badge.textContent = "PASS (ACCURATE FIT)";
        badge.className = "text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wide bg-emerald-600 text-white";
      } else {
        badge.textContent = "FAIL (DONNING DEFICIT)";
        badge.className = "text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wide bg-rose-600 text-white";
      }
    }

    function toggleCriteriaHelp(helpId) {
      const el = document.getElementById(helpId);
      el.classList.toggle('hidden');
    }

    function updateConfidenceText(val) {
      const map = {
        1: "1 - Very Low / Guess",
        2: "2 - Low / Suboptimal View",
        3: "3 - Moderate Confidence",
        4: "4 - High Confidence",
        5: "5 - Absolute Certainty"
      };
      document.getElementById('confidenceLabel').textContent = map[val] || `${val}`;
    }

    function toggleConsensusFlag() {
      const current = studyState.images[studyState.currentIndex];
      if (!current) return;

      const record = studyState.scores[current.id] || {};
      const newStatus = !record.flagConsensus;
      record.flagConsensus = newStatus;
      studyState.scores[current.id] = record;

      const flagIndicator = document.getElementById('flagIndicatorBadge');
      const flagBtnText = document.getElementById('flagBtnText');
      const flagNoteBox = document.getElementById('flagNoteContainer');

      if (newStatus) {
        flagIndicator.classList.remove('hidden');
        flagIndicator.classList.add('inline-flex');
        flagBtnText.textContent = "Flagged";
        flagNoteBox.classList.remove('hidden');
        showToast("Specimen marked for consensus panel review", "warning");
      } else {
        flagIndicator.classList.add('hidden');
        flagIndicator.classList.remove('inline-flex');
        flagBtnText.textContent = "Flag for Consensus";
        flagNoteBox.classList.add('hidden');
        showToast("Consensus flag cleared", "info");
      }
      saveToStorage();
      lucide.createIcons();
    }

    /* ==========================================================================
       SUBMISSION, RECORD ACCUMULATION & ADVANCEMENT
       ========================================================================== */
    async function saveAndAdvance() {
      const current = studyState.images[studyState.currentIndex];
      if (!current) return;

      // Extract Category 1-6 choices
      const catScores = {};
      let unanswered = [];
      for (let i = 1; i <= 6; i++) {
        const checked = document.querySelector(`input[name="cat${i}"]:checked`);
        if (!checked) {
          unanswered.push(i);
        } else {
          catScores[`cat${i}`] = parseInt(checked.value, 10);
        }
      }

      if (unanswered.length > 0) {
        showToast(`Please score mandatory Categories: ${unanswered.join(', ')}`, "warning");
        return;
      }

      const totalScore = Object.values(catScores).filter(v => v === 1).length;
      const posture = document.getElementById('postureSelect').value;
      const setting = document.getElementById('settingSelect').value;
      const confidence = parseInt(document.getElementById('confidenceRange').value, 10);
      const notes = document.getElementById('raterNotes').value.trim();
      const flagReason = document.getElementById('flagReasonInput').value.trim();
      const existing = studyState.scores[current.id] || {};
      const flag = !!existing.flagConsensus;

      // Structured Tidy Row Record
      const record = {
        raterId: studyState.raterId,
        imageId: current.id,
        blindedId: `BLIND_${studyState.currentIndex + 1}`,
        timestamp: new Date().toISOString(),
        cat1_axialOrientation: catScores.cat1,
        cat2_jointLineCenter: catScores.cat2,
        cat3_apPlanePosition: catScores.cat3,
        cat4_patellarAlignment: catScores.cat4,
        cat5_skinInterface: catScores.cat5,
        cat6_strapPlacement: catScores.cat6,
        totalScore: totalScore,
        fitClassification: totalScore === 6 ? "PASS" : "FAIL",
        postureClass: posture,
        settingClass: setting,
        confidenceLevel: confidence,
        flagConsensus: flag,
        flagReason: flagReason,
        notes: notes
      };

      studyState.scores[current.id] = { ...existing, ...record };
      saveToStorage();

      // Transmit to central Google Sheet if Webhook configured
      if (studyState.webhookUrl) {
        postToGoogleSheet(record);
      }

      showToast(`Specimen ${studyState.blinded ? record.blindedId : current.id} saved!`, "success");

      // Advance
      if (studyState.currentIndex < studyState.images.length - 1) {
        navigateImage(1);
      } else {
        showToast("Final specimen completed! All scores saved.", "success");
      }
    }

    function navigateImage(direction) {
      const next = studyState.currentIndex + direction;
      if (next >= 0 && next < studyState.images.length) {
        studyState.currentIndex = next;
        renderCurrentImage();
      }
    }

    function clearActiveRubric() {
      for (let i = 1; i <= 6; i++) {
        const radios = document.querySelectorAll(`input[name="cat${i}"]`);
        radios.forEach(r => r.checked = false);
      }
      document.getElementById('raterNotes').value = "";
      document.getElementById('flagReasonInput').value = "";
      onScoreChange();
    }

    /* ==========================================================================
       CLOUD STORAGE & LOCAL STORAGE ENGINE
       ========================================================================== */
    function saveToStorage() {
      try {
        const payload = {
          raterId: studyState.raterId,
          webhookUrl: studyState.webhookUrl,
          blinded: studyState.blinded,
          scores: studyState.scores
        };
        localStorage.setItem('knee_brace_study_data', JSON.stringify(payload));
      } catch (err) {
        console.warn("Storage sync error", err);
      }
    }

    function loadFromStorage() {
      try {
        const raw = localStorage.getItem('knee_brace_study_data');
        if (raw) {
          const d = JSON.parse(raw);
          if (d.raterId) studyState.raterId = d.raterId;
          if (d.webhookUrl) studyState.webhookUrl = d.webhookUrl;
          if (typeof d.blinded === 'boolean') studyState.blinded = d.blinded;
          if (d.scores) studyState.scores = d.scores;
        }
      } catch (e) {
        console.warn("Cache load error", e);
      }

      document.getElementById('displayRaterId').textContent = studyState.raterId;
      document.getElementById('blindingToggle').checked = studyState.blinded;
    }

    async function postToGoogleSheet(record) {
      const statusBadge = document.getElementById('cloudSyncStatus');
      try {
        statusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span> Sending...`;
        await fetch(studyState.webhookUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(record)
        });
        statusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Synced`;
      } catch (err) {
        console.error("Google Sheets Webhook error:", err);
        statusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Sync Fail`;
      }
    }

    /* ==========================================================================
       EXPORT CSV (TIDY RESEARCH MATRIX)
       ========================================================================== */
    function exportCSV() {
      const records = Object.values(studyState.scores);
      if (records.length === 0) {
        showToast("No evaluations recorded yet to export.", "warning");
        return;
      }

      const headers = [
        "Rater_ID",
        "Image_ID",
        "Blinded_ID",
        "Timestamp_ISO",
        "Cat1_AxialOrientation",
        "Cat2_JointLineCenter",
        "Cat3_APPlanePosition",
        "Cat4_PatellarAlignment",
        "Cat5_SkinInterface",
        "Cat6_StrapPlacement",
        "Total_Score",
        "Fit_Classification",
        "Posture_Class",
        "Setting_Class",
        "Confidence_Level",
        "Flag_Consensus",
        "Flag_Reason",
        "Notes"
      ];

      const rows = records.map(r => [
        escapeCSV(r.raterId),
        escapeCSV(r.imageId),
        escapeCSV(r.blindedId),
        escapeCSV(r.timestamp),
        r.cat1_axialOrientation !== undefined ? r.cat1_axialOrientation : "",
        r.cat2_jointLineCenter !== undefined ? r.cat2_jointLineCenter : "",
        r.cat3_apPlanePosition !== undefined ? r.cat3_apPlanePosition : "",
        r.cat4_patellarAlignment !== undefined ? r.cat4_patellarAlignment : "",
        r.cat5_skinInterface !== undefined ? r.cat5_skinInterface : "",
        r.cat6_strapPlacement !== undefined ? r.cat6_strapPlacement : "",
        r.totalScore !== undefined ? r.totalScore : "",
        escapeCSV(r.fitClassification),
        escapeCSV(r.postureClass),
        escapeCSV(r.settingClass),
        r.confidenceLevel || "",
        r.flagConsensus ? "TRUE" : "FALSE",
        escapeCSV(r.flagReason || ""),
        escapeCSV(r.notes || "")
      ]);

      const csvText = [headers.join(","), ...rows.map(row => row.join(","))].join("\r\n");
      const blob = new Blob([csvText], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      const safeRater = studyState.raterId.replace(/[^a-z0-9_-]/gi, '_');
      const dateStr = new Date().toISOString().slice(0, 10);
      
      link.setAttribute("href", url);
      link.setAttribute("download", `brace_scoring_dataset_${safeRater}_${dateStr}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);

      showToast("Tidy CSV downloaded successfully!", "success");
    }

    function escapeCSV(val) {
      if (val === null || val === undefined) return '""';
      const s = String(val).replace(/"/g, '""');
      return `"${s}"`;
    }

    /* ==========================================================================
       CONFIG & DATASET INGESTION MODAL
       ========================================================================== */
    function openConfigModal() {
      document.getElementById('modalRaterId').value = studyState.raterId;
      document.getElementById('modalWebhookUrl').value = studyState.webhookUrl || "";
      document.getElementById('configModal').classList.remove('hidden');
    }

    function closeConfigModal() {
      document.getElementById('configModal').classList.add('hidden');
    }

    function toggleBlindingMode() {
      studyState.blinded = document.getElementById('blindingToggle').checked;
      saveToStorage();
      renderCurrentImage();
      showToast(studyState.blinded ? "Blinding Activated: Filenames masked" : "Blinding Disabled", "info");
    }

    let activeIngestTab = 'manifest';
    function setIngestTab(tab) {
      activeIngestTab = tab;
      const btnM = document.getElementById('tabManifest');
      const btnL = document.getElementById('tabLocal');
      const secM = document.getElementById('ingestManifestSection');
      const secL = document.getElementById('ingestLocalSection');

      if (tab === 'manifest') {
        btnM.className = "px-3 py-1 rounded bg-clinical-50 border border-clinical-500 text-clinical-800 font-semibold text-xs";
        btnL.className = "px-3 py-1 rounded bg-white border border-slate-300 text-slate-600 hover:bg-slate-50 font-semibold text-xs";
        secM.classList.remove('hidden');
        secL.classList.add('hidden');
      } else {
        btnL.className = "px-3 py-1 rounded bg-clinical-50 border border-clinical-500 text-clinical-800 font-semibold text-xs";
        btnM.className = "px-3 py-1 rounded bg-white border border-slate-300 text-slate-600 hover:bg-slate-50 font-semibold text-xs";
        secL.classList.remove('hidden');
        secM.classList.add('hidden');
      }
    }

    function saveConfiguration() {
      const rId = document.getElementById('modalRaterId').value.trim();
      if (!rId) {
        showToast("Rater Identifier cannot be blank", "warning");
        return;
      }

      studyState.raterId = rId;
      studyState.webhookUrl = document.getElementById('modalWebhookUrl').value.trim();
      document.getElementById('displayRaterId').textContent = rId;

      // Check if new dataset loaded
      if (activeIngestTab === 'local') {
        const fileInput = document.getElementById('localFilesInput');
        if (fileInput.files && fileInput.files.length > 0) {
          const files = Array.from(fileInput.files);
          studyState.images = files.map(file => ({
            id: file.name,
            url: URL.createObjectURL(file)
          }));
          studyState.currentIndex = 0;
          showToast(`Ingested ${files.length} local images!`, "success");
        }
      } else {
        const text = document.getElementById('manifestTextarea').value.trim();
        if (text) {
          const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
          if (lines.length > 0) {
            studyState.images = lines.map(line => {
              const filename = line.split('/').pop().split('?')[0] || "IMAGE.jpg";
              return { id: filename, url: line };
            });
            studyState.currentIndex = 0;
            showToast(`Loaded ${lines.length} paths into study!`, "success");
          }
        }
      }

      saveToStorage();
      closeConfigModal();
      renderCurrentImage();
    }

    function restoreDefaultImages() {
      studyState.images = [...DEFAULT_SPECIMENS];
      studyState.currentIndex = 0;
      saveToStorage();
      closeConfigModal();
      renderCurrentImage();
      showToast("Reset to default knee brace dataset.", "info");
    }

    /* ==========================================================================
       GOOGLE APPS SCRIPT BACKEND TEMPLATE
       ========================================================================== */
